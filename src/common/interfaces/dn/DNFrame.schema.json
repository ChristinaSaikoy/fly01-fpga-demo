{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo.dnframe.v1",
  "title": "DNFrame",
  "type": "object",
  "required": [
    "frame_id",
    "timestamp_s",
    "dt_s",
    "slots",
    "source_id",
    "replay_id",
    "stimulus_state",
    "source_timestep",
    "schema_version"
  ],
  "properties": {
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_s": {
      "type": "number"
    },
    "dt_s": {
      "const": 0.02
    },
    "slots": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "source_id": {
      "type": "string"
    },
    "replay_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stimulus_state": {
      "type": "string"
    },
    "source_timestep": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "const": "demo.dnframe.v1"
    }
  }
}
